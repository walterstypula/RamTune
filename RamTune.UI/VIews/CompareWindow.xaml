<Window x:Class="RamTune.UI.Views.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:vm="clr-namespace:RamTune.UI.ViewModels"
        xmlns:core="clr-namespace:RamTune.Core;assembly=RamTune.Core"
        xmlns:views="clr-namespace:RamTune.UI.Views"
        mc:Ignorable="d"
        Title="RamTune - Compare ROMs"
        Width="1400"
        Height="800"
        Background="#252526">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Muted">
            <Setter Property="Foreground" Value="{StaticResource RamTune.Compare.Missing}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- One side of the comparison: axis descriptions around the shared Table view -->
        <DataTemplate x:Key="TablePanel" DataType="{x:Type vm:TableDisplayVM}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Label Content="{Binding RowDescription}" Foreground="{StaticResource RamTune.Table.Description}" VerticalAlignment="Center">
                    <Label.LayoutTransform>
                        <RotateTransform Angle="270" />
                    </Label.LayoutTransform>
                </Label>
                <StackPanel>
                    <Label Content="{Binding ColumnDescription}" Foreground="{StaticResource RamTune.Table.Description}" HorizontalAlignment="Center" />
                    <views:Table DataContext="{Binding .}" HorizontalAlignment="Center" />
                    <Label Content="{Binding TableDescription}" Foreground="{StaticResource RamTune.Table.Description}" HorizontalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <Style TargetType="TextBlock" x:Key="StatusName">
            <Setter Property="Foreground" Value="#C8C8C8" />
            <Setter Property="Margin" Value="4,1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:ComparisonStatus.Different}">
                    <Setter Property="Foreground" Value="{StaticResource RamTune.Compare.Different}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:ComparisonStatus.SizeMismatch}">
                    <Setter Property="Foreground" Value="{StaticResource RamTune.Compare.SizeMismatch}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:ComparisonStatus.OnlyLeft}">
                    <Setter Property="Foreground" Value="{StaticResource RamTune.Compare.Missing}" />
                    <Setter Property="FontStyle" Value="Italic" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:ComparisonStatus.OnlyRight}">
                    <Setter Property="Foreground" Value="{StaticResource RamTune.Compare.Missing}" />
                    <Setter Property="FontStyle" Value="Italic" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Toolbar: left ROM | filters | right ROM -->
        <Border DockPanel.Dock="Top" BorderBrush="DimGray" BorderThickness="0 0 0 1" Padding="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="Open left…" Command="{Binding OpenLeftCommand}" Style="{StaticResource TextButton}" />
                    <Button Content="Save left as…" Command="{Binding SaveLeftCommand}" Style="{StaticResource TextButton}" />
                    <TextBlock Text="{Binding LeftTitle}" Foreground="White" FontSize="13" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <TextBlock Text="Find" Foreground="White" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Width="180" FontSize="13"
                             Background="{StaticResource RamTune.Compare.Panel}" Foreground="White" BorderBrush="DimGray" CaretBrush="White" />
                    <CheckBox IsChecked="{Binding ShowOnlyDifferences}" Content="Differences only" Foreground="White" FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding RightTitle}" Foreground="White" FontSize="13" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" />
                    <Button Content="Open right…" Command="{Binding OpenRightCommand}" Style="{StaticResource TextButton}" />
                    <Button Content="Save right as…" Command="{Binding SaveRightCommand}" Style="{StaticResource TextButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" BorderBrush="DimGray" BorderThickness="0 1 0 0" Padding="8,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource Muted}" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontSize="13" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition MinWidth="160" Width="320" />
                <ColumnDefinition Width="2" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <GridSplitter Grid.Column="1" Background="{StaticResource RamTune.Grid.Splitter}" Width="1" HorizontalAlignment="Stretch" />

            <!-- Matched tables, grouped by category -->
            <TreeView x:Name="TablesTV" Grid.Column="0" ItemsSource="{Binding Groups}" Background="{x:Null}" BorderBrush="{x:Null}">
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type vm:CompareGroupVM}" ItemsSource="{Binding Tables}">
                        <TextBlock Text="{Binding Name}" Foreground="White" Margin="2" />
                    </HierarchicalDataTemplate>
                    <DataTemplate DataType="{x:Type vm:TableComparisonVM}">
                        <TextBlock Text="{Binding Name}" ToolTip="{Binding StatusText}" Style="{StaticResource StatusName}" />
                    </DataTemplate>
                </TreeView.Resources>
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectedItemChanged">
                        <i:InvokeCommandAction Command="{Binding SelectedItemChangedCommand}" CommandParameter="{Binding SelectedItem, ElementName=TablesTV}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="{x:Type TreeViewItem}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                        <Style.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#0078D7" />
                        </Style.Resources>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>

            <!-- Left ROM -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="{Binding LeftTitle}" Foreground="White" FontSize="13" Margin="8,6" TextTrimming="CharacterEllipsis" />
                <Grid>
                    <ScrollViewer x:Name="LeftScroll" ScrollChanged="TableScroll_ScrollChanged" Margin="5" CanContentScroll="False" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ContentControl Content="{Binding Selected.LeftTable}" ContentTemplate="{StaticResource TablePanel}" Focusable="False" />
                    </ScrollViewer>
                    <TextBlock Text="{Binding Selected.LeftNote}" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </DockPanel>

            <!-- Copy actions -->
            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="4,0">
                <TextBlock Text="{Binding Selected.Name}" Foreground="White" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="150" Margin="0,0,0,4" />
                <TextBlock Text="{Binding Selected.StatusText}" Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="150" Margin="0,0,0,12" />
                <Button Content="Copy table  →" Command="{Binding CopyTableToRightCommand}" Style="{StaticResource TextButton}" ToolTip="Copy the whole table, including its axes, from the left ROM to the right ROM" />
                <Button Content="Copy selected  →" Command="{Binding CopySelectedToRightCommand}" Style="{StaticResource TextButton}" ToolTip="Copy the cells selected in the left table to the same cells in the right table" />
                <Border Height="16" />
                <Button Content="←  Copy selected" Command="{Binding CopySelectedToLeftCommand}" Style="{StaticResource TextButton}" ToolTip="Copy the cells selected in the right table to the same cells in the left table" />
                <Button Content="←  Copy table" Command="{Binding CopyTableToLeftCommand}" Style="{StaticResource TextButton}" ToolTip="Copy the whole table, including its axes, from the right ROM to the left ROM" />
            </StackPanel>

            <!-- Right ROM -->
            <DockPanel Grid.Column="4">
                <TextBlock DockPanel.Dock="Top" Text="{Binding RightTitle}" Foreground="White" FontSize="13" Margin="8,6" TextTrimming="CharacterEllipsis" />
                <Grid>
                    <ScrollViewer x:Name="RightScroll" ScrollChanged="TableScroll_ScrollChanged" Margin="5" CanContentScroll="False" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ContentControl Content="{Binding Selected.RightTable}" ContentTemplate="{StaticResource TablePanel}" Focusable="False" />
                    </ScrollViewer>
                    <TextBlock Text="{Binding Selected.RightNote}" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
